# Production mode requires persistent secrets. Generate with: openssl rand -hex 32
APP_ENV=production
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_PASSCODE=replace-with-your-admin-passcode

# SMTP credentials used for one-time login codes
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-sender@example.com
SMTP_PASS=replace-with-your-smtp-password

# Contabo Object Storage (S3-compatible)
OBJECT_STORAGE_ENDPOINT_URL=https://eu2.contabostorage.com
OBJECT_STORAGE_REGION=eu
OBJECT_STORAGE_BUCKET=academichub
OBJECT_STORAGE_ACCESS_KEY=replace-with-your-contabo-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-your-contabo-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Optional comma-separated origins only if a separate frontend origin is required.
# Prefer same-origin frontend/API hosting and leave this empty.
CORS_ALLOWED_ORIGINS=
